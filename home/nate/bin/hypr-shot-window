#!/usr/bin/env bash
# hypr-shot-window: capture a specific window using slurp -r
set -euo pipefail
DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"
GEOMETRY=$(hyprctl -j clients 2>/dev/null | jq -r '.[] | select(.mapped==true and .hidden==false) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | slurp -r)
if [ -z "$GEOMETRY" ]; then
    notify-send -a Screenshot "Cancelled" 2>/dev/null || true
    exit 1
fi
grim -g "$GEOMETRY" "$FILE" && wl-copy -t image/png < "$FILE"
