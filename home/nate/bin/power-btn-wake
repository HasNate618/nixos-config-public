#!/usr/bin/env bash
# Called by hypridle on-resume (1s listener) on every input wake.
# kbd restore is idempotent (noop without a pending save file);
# DPMS re-enable only when the power-button flag is set.
"$HOME/.local/bin/kbd-save-restore" restore

FLAG="/tmp/power-btn-active"
if [[ -f "$FLAG" ]]; then
    # Restore display via DPMS
    hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'
    # Clear flag
    rm -f "$FLAG"
fi
