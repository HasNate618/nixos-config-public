#!/bin/sh
# Set keyboard backlight to the matugen primary colour (3x saturation).
# Runs as the "skwd" integration reload hook, i.e. AFTER matugen rendered the
# palette — as a postProcessing hook it ran before theming and coloured the
# keyboard from the previous wallpaper.
#
# asusctl aura re-inits the LED controller and resets brightness to 1, so the
# user's level is saved and restored around the call.

COLORS_JSON="/home/nate/.cache/skwd/colors.json"
LOG="$HOME/.cache/skwd-wall-v2/kb-backlight.log"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null || true; }

[ -f "$COLORS_JSON" ] || { log "no palette at $COLORS_JSON, skipped"; exit 0; }

# Extract primary color hex (without #)
PRIMARY=$(grep -o '"primary": "#[0-9a-fA-F]*"' "$COLORS_JSON" | head -1 | sed 's/"primary": "#//;s/"//')
[ -z "$PRIMARY" ] && { log "palette has no primary, skipped"; exit 0; }

# RGB→HSV, boost saturation 1.5x, HSV→RGB
SATURATED=$(/etc/profiles/per-user/nate/bin/python3 -c "
import colorsys
hex_c = '$PRIMARY'
r = int(hex_c[0:2], 16) / 255.0
g = int(hex_c[2:4], 16) / 255.0
b = int(hex_c[4:6], 16) / 255.0
h, s, v = colorsys.rgb_to_hsv(r, g, b)
# Wallpaper-derived primaries are desaturated near-grey; boost saturation so the
# LEDs show the hue. Value is left untouched.
s_new = min(1.0, s * 3.0)
r2, g2, b2 = colorsys.hsv_to_rgb(h, s_new, v)
print(f'{int(r2*255):02x}{int(g2*255):02x}{int(b2*255):02x}')
" 2>/dev/null)

[ -z "$SATURATED" ] && { log "saturation step failed, skipped"; exit 0; }

# asusctl aura re-inits the LED controller and resets brightness to 1 —
# save and restore the user's level around the call.
CUR=$(brightnessctl -d '*::kbd_backlight' get 2>/dev/null)
asusctl aura effect static -c "$SATURATED" 2>/dev/null
rc=$?
sleep 0.3
[ -n "$CUR" ] && brightnessctl -d '*::kbd_backlight' set "$CUR" 2>/dev/null
log "primary=#$PRIMARY kbd=#$SATURATED brightness=$CUR asusctl_rc=$rc"

# keep the log bounded
if [ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 300 ]; then
  tail -n 150 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null || true
fi
