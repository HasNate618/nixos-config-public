#!/usr/bin/env bash
# corne-battery — outputs {"left":71,"right":95} for QuickShell
# Requires CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y + FETCHING=y
set -euo pipefail
MAC_FRAGMENT="${CORNE_MAC:-F0_9A_62_B9_46_2E}"
# find hci device path (hci0 vs hci1)
DEV_PATH=$(busctl tree org.bluez 2>/dev/null | grep -oE "/org/bluez/hci[0-9]/dev_${MAC_FRAGMENT}" | head -1)
if [ -z "$DEV_PATH" ]; then
  echo '{"error":"Corne not connected"}'
  exit 0
fi
# enumerate Battery Level chars
left="" ; right=""
for c in $(busctl tree org.bluez 2>/dev/null | grep -oE "${DEV_PATH}/service[0-9a-f]+/char[0-9a-f]+" | sort -u); do
  uuid=$(busctl get-property org.bluez "$c" org.bluez.GattCharacteristic1 UUID 2>/dev/null | grep -oE '"[0-9a-f-]+"' | tr -d '"')
  if [ "${uuid,,}" != "00002a19-0000-1000-8000-00805f9b34fb" ]; then continue; fi
  # check for User Description descriptor 2901
  has_2901=$(busctl tree org.bluez 2>/dev/null | grep -c "^${c}/desc" || true)
  has_2901_desc=0
  for d in $(busctl tree org.bluez 2>/dev/null | grep -oE "${c}/desc[0-9a-f]+" | sort -u); do
    duuid=$(busctl get-property org.bluez "$d" org.bluez.GattDescriptor1 UUID 2>/dev/null | grep -oE '"[0-9a-f-]+"' | tr -d '"')
    if [ "${duuid,,}" = "00002901-0000-1000-8000-00805f9b34fb" ]; then has_2901_desc=1; break; fi
  done
  val=$(busctl call org.bluez "$c" org.bluez.GattCharacteristic1 ReadValue a{sv} 0 2>/dev/null | grep -oE "[0-9]+" | tail -1)
  if [ -z "$val" ]; then continue; fi
  if [ "$has_2901_desc" = 1 ]; then right="$val"; else left="$val"; fi
done
# output JSON (only include present values)
if [ -n "$left" ] && [ -n "$right" ]; then echo "{\"left\":$left,\"right\":$right}"
elif [ -n "$left" ]; then echo "{\"left\":$left}"
elif [ -n "$right" ]; then echo "{\"right\":$right}"
else echo '{"error":"no battery chars found"}'
fi
