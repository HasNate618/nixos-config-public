#!/usr/bin/env bash
# corne-battery — outputs {"left":..,"right":..} and {"central":..,"peripheral":..}
# Works for either left-central (default) or right-central (swapped) builds
set -euo pipefail
# auto-find Corne device path by name if MAC env not set
if [ -n "${CORNE_MAC:-}" ]; then
  MAC_FRAGMENT="${CORNE_MAC//:/_}"
else
  # try to find connected Corne
  DEV_PATH=$(busctl tree org.bluez 2>/dev/null | grep -oE "/org/bluez/hci[0-9]/dev_[0-9A-F_]+/service0010" | head -1 | sed 's|/service.*||')
  if [ -z "$DEV_PATH" ]; then
    # no service0010 match: locate the keyboard by scanning BlueZ objects
    # for a device whose advertised name mentions Corne
    for p in $(busctl tree org.bluez 2>/dev/null | grep -oE "/org/bluez/hci[0-9]/dev_[0-9A-F_]+"); do
      name=$(busctl get-property org.bluez "$p" org.bluez.Device1 Name 2>/dev/null | grep -oE '"[^"]+"' | tr -d '"' || true)
      if echo "$name" | grep -qi corne; then DEV_PATH="$p"; break; fi
    done
  fi
fi
if [ -z "${DEV_PATH:-}" ] || ! busctl tree org.bluez 2>/dev/null | grep -q "$DEV_PATH"; then
  # last resort: find any Battery Service
  for c in $(busctl tree org.bluez 2>/dev/null | grep -oE "/org/bluez/hci[0-9]/dev_[0-9A-F_]+/service[0-9a-f]+/char[0-9a-f]+" | sort -u); do
    uuid=$(busctl get-property org.bluez "$c" org.bluez.GattCharacteristic1 UUID 2>/dev/null | grep -oE '"[0-9a-f-]+"' | tr -d '"' || true)
    if [ "${uuid,,}" = "00002a19-0000-1000-8000-00805f9b34fb" ]; then
      DEV_PATH=$(echo "$c" | sed -E 's|/service.*||')
      break
    fi
  done
fi
if [ -z "${DEV_PATH:-}" ]; then echo '{"error":"Corne not connected"}'; exit 0; fi
# enumerate Battery Level chars under this device
central="" ; peripheral=""
for c in $(busctl tree org.bluez 2>/dev/null | grep -oE "${DEV_PATH}/service[0-9a-f]+/char[0-9a-f]+" | sort -u); do
  uuid=$(busctl get-property org.bluez "$c" org.bluez.GattCharacteristic1 UUID 2>/dev/null | grep -oE '"[0-9a-f-]+"' | tr -d '"' || true)
  [ "${uuid,,}" != "00002a19-0000-1000-8000-00805f9b34fb" ] && continue
  has_2901=0
  for d in $(busctl tree org.bluez 2>/dev/null | grep -oE "${c}/desc[0-9a-f]+" | sort -u); do
    duuid=$(busctl get-property org.bluez "$d" org.bluez.GattDescriptor1 UUID 2>/dev/null | grep -oE '"[0-9a-f-]+"' | tr -d '"' || true)
    [ "${duuid,,}" = "00002901-0000-1000-8000-00805f9b34fb" ] && has_2901=1 && break
  done
  val=$(busctl call org.bluez "$c" org.bluez.GattCharacteristic1 ReadValue a{sv} 0 2>/dev/null | grep -oE "[0-9]+" | tail -1 || true)
  [ -z "$val" ] && continue
  if [ "$has_2901" = 1 ]; then peripheral="$val"; else central="$val"; fi
done
# detect role-swapped build: check which .conf has ROLE_CENTRAL=y
IS_SWAPPED=0
ZMK_CONF="${ZMK_CORNE_CONFIG:-$HOME/zmk-corne-config}/config/corne_right.conf"
if grep -q "CONFIG_ZMK_SPLIT_ROLE_CENTRAL=y" "$ZMK_CONF" 2>/dev/null; then IS_SWAPPED=1; fi
if [ "$IS_SWAPPED" = 1 ]; then
  # right is central, left is peripheral
  left="$peripheral"; right="$central"
  # also output central/peripheral for clarity
  if [ -n "$central" ] && [ -n "$peripheral" ]; then
    echo "{\"left\":$left,\"right\":$right,\"central\":$central,\"peripheral\":$peripheral,\"swapped\":true}"
  elif [ -n "$central" ]; then echo "{\"central\":$central,\"swapped\":true}"
  else echo "{\"peripheral\":$peripheral,\"swapped\":true}"; fi
else
  left="$central"; right="$peripheral"
  if [ -n "$left" ] && [ -n "$right" ]; then echo "{\"left\":$left,\"right\":$right,\"central\":$central,\"peripheral\":$peripheral}"
  elif [ -n "$left" ]; then echo "{\"left\":$left,\"central\":$central}"
  else echo "{\"right\":$right,\"peripheral\":$peripheral}"; fi
fi
