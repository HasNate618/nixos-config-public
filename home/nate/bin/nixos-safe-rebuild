#!/usr/bin/env bash
# Safe NixOS rebuild wrapper — prevents rebuilding with wrong flake target
# Usage: nixos-safe-rebuild [extra nixos-rebuild args]
#
# Re-execs via sudo when not root (NOPASSWD rule in hosts/nixos/default.nix),
# so agents can call this directly instead of raw "sudo nixos-rebuild switch".

set -euo pipefail

# Re-exec with sudo if not already root
if [[ $EUID -ne 0 ]]; then
  exec sudo /home/nate/.local/bin/nixos-safe-rebuild "$@"
fi

HOSTNAME=$(hostname)
FLAKE_DIR="/etc/nixos"

# Extract --flake target from args or default to current hostname
FLAKE_TARGET="$HOSTNAME"
ACTION="switch"
EXTRA_ARGS=()

i=1
while (( i<=$# )); do
  arg="${!i}"
  case "$arg" in
    --flake)
      next=$((i+1))
      flake_val="${!next}"
      # Extract target from .#target format
      FLAKE_TARGET="${flake_val##*.#}"
      # Drop it: we always supply our own --flake below (avoids duplicates)
      ((i+=2))
      ;;
    switch|boot|test|build|dry-build|dry-run|dry-activate|build-vm|build-vm-with-bootloader|edit|repl|rollback|list-generations)
      ACTION="$arg"
      ((i+=1))
      ;;
    *)
      EXTRA_ARGS+=("$arg")
      ((i+=1))
      ;;
  esac
done

# Validate target matches hostname
if [[ "$FLAKE_TARGET" != "$HOSTNAME" ]]; then
  echo "ERROR: Flake target '$FLAKE_TARGET' doesn't match hostname '$HOSTNAME'" >&2
  echo "" >&2
  echo "This would rebuild with the wrong host config." >&2
  echo "If you really mean to do this, use: nixos-rebuild --flake .#$FLAKE_TARGET $ACTION" >&2
  exit 1
fi

# Run the rebuild.
# NOTE (2026-09-19): nixos-rebuild now requires the action AFTER all options
# (`switch --flake ...` fails with "unrecognized arguments: switch").
exec nixos-rebuild --flake "$FLAKE_DIR#$FLAKE_TARGET" "${EXTRA_ARGS[@]}" "$ACTION"
