#!/bin/sh
# Post-wallpaper-apply hook: runs matugen, pushes colors to quickshell

# Get current wallpaper path from cache
WALL=$(cat "$HOME/.cache/skwd-wall/last-wallpaper.json" 2>/dev/null | sed 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
[ -z "$WALL" ] && exit 0
[ ! -f "$WALL" ] && exit 0

# Config path
CONFIG="$HOME/.cache/skwd-wall/matugen-config.toml"
[ ! -f "$CONFIG" ] && exit 0

# Run matugen with --source-color-index 0 to bypass TUI
/nix/store/bd8c1a8nh2zspylx62pnl130dg8an2dh-matugen-4.0.0/bin/matugen \
    -c "$CONFIG" \
    image "$WALL" \
    --source-color-index 0 2>/dev/null

# Push colors to quickshell
/home/nate/.local/bin/quickshell-theme-push 2>/dev/null

exit 0
