#!/usr/bin/env bash
# Power button: lock + kbd off + dpms off
# Kbd save/restore is shared with hypridle via kbd-save-restore (single
# /tmp/kbd-brightness file, first-wins, idempotent restore). FLAG only
# gates the DPMS re-enable on wake.
FLAG="/tmp/power-btn-active"

restore() {
    "$HOME/.local/bin/kbd-save-restore" restore
    if [[ -f "$FLAG" ]]; then
        hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'
        rm -f "$FLAG"
    fi
}

trap restore EXIT

# If hypridle is disabled, just lock — no kbd/dpms tricks
if ! systemctl --user is-active hypridle >/dev/null 2>&1; then
    hyprlock --immediate-render
    exit 0
fi

# Save + turn off kbd (save records 0 too — explicit off survives)
"$HOME/.local/bin/kbd-save-restore" save

# Turn off display via DPMS
hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })'

# Set flag for hypridle to restore on wake
touch "$FLAG"

# Lock screen (blocks until unlock)
hyprlock --immediate-render
