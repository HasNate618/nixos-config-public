{
  "monitor": "",
  "general": {
    "locale": "",
    "closeOnSelection": false,
    "filterBarAlwaysVisible": true,
    "applyOnPickerMonitor": true,
    "notifyOnWallpaperChange": false
  },
  "paths": {
    "wallpaper": "~/Pictures/Wallpapers",
    "videoWallpaper": "~/videowalls"
  },
  "features": {
    "matugen": true,
    "wallhaven": true
  },
  "theme": {
    "engine": "matugen",
    "policy": "wallpaper",
    "authority": "skwd",
    "mode": "dark"
  },
  "matugen": {
    "schemeType": "scheme-content",
    "mode": "dark",
    "colorIndex": 0
  },
  "wallpaperMute": true,
  "postProcessOnRestore": true,
  "postProcessing": [
    "ln -sf \"$(jq -r '.path' /home/nate/.cache/skwd-wall-v2/last-wallpaper.json 2>/dev/null)\" /home/nate/.config/hypr/lock-bg 2>/dev/null || true",
    "/home/nate/.local/bin/herdr-kill-client 2>/dev/null || true"
  ],
  "integrations": [
    {
      "_comment": "MD3 colors for the Skwd shell widgets (skwd-bar etc)",
      "name": "skwd",
      "template": "quickshell-colors.json",
      "output": "~/.cache/skwd/colors.json",
      "reload": "/home/nate/.local/bin/kb-backlight-matugen"
    },
    {
      "_comment": "Quickshell desktop bar + omni-menu palette",
      "name": "quickshell",
      "template": "quickshell-colors.toml",
      "output": "~/.config/quickshell/colors.toml",
      "reload": "/home/nate/.local/bin/quickshell-theme-push"
    },
    {
      "name": "kitty",
      "template": "kitty.conf",
      "output": "~/.config/kitty/skwd-theme.conf",
      "reload": "pkill -USR1 kitty"
    },
    {
      "name": "ghostty",
      "template": "ghostty.conf",
      "output": "~/.config/ghostty/skwd-theme",
      "reload": "pkill -USR2 ghostty"
    },
    {
      "name": "kde",
      "template": "kde-colors.colors",
      "output": "~/.local/share/color-schemes/SkwdMatugen.colors",
      "reload": "/home/nate/.config/skwd-wall/scripts/reload-kde.sh"
    },
    {
      "name": "vesktop",
      "template": "vesktop.css",
      "output": "~/.config/vesktop/themes/kitty-match.css"
    },
    {
      "name": "yazi",
      "template": "yazi-theme.toml",
      "output": "~/.config/yazi/theme.toml"
    },
    {
      "name": "qt6ct",
      "template": "qt6ct-colors.conf",
      "output": "~/.config/qt6ct/colors/matugen.conf"
    },
    {
      "_comment": "Kvantum Qt theme \u2014 translucent windows/menus + matugen colors (SkwdDark, base KvAdaptaDark)",
      "name": "kvantum",
      "template": "kvantum-kvconfig",
      "output": "~/.config/Kvantum/SkwdDark/SkwdDark.kvconfig",
      "reload": ""
    },
    {
      "_comment": "Kvantum theme base SVG \u2014 KvAdaptaDark recolored from the matugen palette",
      "name": "kvantum-svg",
      "template": "kvantum-svg",
      "output": "~/.config/Kvantum/SkwdDark/SkwdDark.svg",
      "reload": ""
    },
    {
      "_comment": "Kvantum Alt theme (SkwdAlt) \u2014 flat minimal dark base, translucent + matugen colors",
      "name": "kvantum-alt",
      "template": "kvantum-alt-kvconfig",
      "output": "~/.config/Kvantum/SkwdAlt/SkwdAlt.kvconfig",
      "reload": ""
    },
    {
      "_comment": "SkwdAlt base SVG \u2014 KvantumAlt recolored from the matugen palette",
      "name": "kvantum-alt-svg",
      "template": "kvantum-alt-svg",
      "output": "~/.config/Kvantum/SkwdAlt/SkwdAlt.svg",
      "reload": ""
    },
    {
      "_comment": "Zen theme in zen-themes/ for automatic hot-reload \u2014 no Marionette needed",
      "name": "zen",
      "template": "zen-transparency.css",
      "output": "~/.config/zen/xxxxxxxx.Default (release)/chrome/zen-themes/matugen-transparency/chrome.css",
      "reload": "/home/nate/.config/skwd-wall/scripts/reload-zen.sh"
    },
    {
      "_comment": "Chromium theme colors for Stylus or userstyle manager",
      "name": "chromium",
      "template": "chromium.css",
      "output": "~/.config/chromium/matugen-colors.css"
    },
    {
      "_comment": "btop system monitor theme \u2014 SIGUSR2 hot-reloads without restart",
      "name": "btop",
      "template": "btop.theme",
      "output": "~/.config/btop/themes/matugen.theme",
      "reload": "pkill -SIGUSR2 btop 2>/dev/null || true"
    },
    {
      "_comment": "cava audio visualizer theme \u2014 USR2 reloads colors",
      "name": "cava",
      "template": "cava-config",
      "output": "~/.config/cava/themes/matugen",
      "reload": "pkill -USR2 cava 2>/dev/null || true"
    },
    {
      "_comment": "lazygit git TUI config (gui.theme section only \u2014 rest is skwd-managed)",
      "name": "lazygit",
      "template": "lazygit-config.yml",
      "output": "~/.config/lazygit/config.yml"
    },
    {
      "_comment": "neovim colorscheme for aether.nvim hot-reload",
      "name": "neovim",
      "template": "neovim.lua",
      "output": "~/.config/nvim/theme/matugen.lua",
      "reload": "pkill -USR1 nvim"
    },
    {
      "_comment": "Hyprland window borders \u2014 accent active, darkened accent inactive",
      "name": "hyprland-borders",
      "template": "hyprland-border-color",
      "output": "~/.cache/skwd-wall/hyprland-border-color",
      "reload": "/etc/profiles/per-user/nate/bin/hyprland-border-theme"
    },
    {
      "_comment": "Hyprland group window borders \u2014 tertiary active, darkened tertiary inactive",
      "name": "hyprland-group-borders",
      "template": "hyprland-group-border-color",
      "output": "~/.cache/skwd-wall/hyprland-group-border-color",
      "reload": "/etc/profiles/per-user/nate/bin/hyprland-border-theme"
    },
    {
      "_comment": "GTK3 CSS overrides for matugen colors",
      "name": "gtk3",
      "template": "gtk3-css.css",
      "output": "~/.config/gtk-3.0/gtk.css",
      "reload": "systemctl --user restart xdg-desktop-portal-gtk.service || true"
    },
    {
      "_comment": "GTK4 CSS overrides for matugen colors",
      "name": "gtk4",
      "template": "gtk4-css.css",
      "output": "~/.config/gtk-4.0/gtk.css",
      "reload": "bash /home/nate/.config/skwd-wall/scripts/patch-monotheme.sh; pkill -f '[n]autilus' || true"
    },
    {
      "_comment": "Hyprlock lockscreen \u2014 matugen-themed color variables",
      "name": "hyprlock",
      "template": "hyprlock-theme.conf",
      "output": "~/.config/hypr/hyprlock-theme.conf",
      "reload": ""
    },
    {
      "_comment": "foot terminal emulator \u2014 USR1 reloads config",
      "name": "foot",
      "template": "foot-colors.conf",
      "output": "~/.config/foot/colors.ini",
      "reload": "/home/nate/.local/bin/foot-reload-colors.sh"
    },
    {
      "name": "swayosd",
      "template": "swayosd.css",
      "output": "~/.config/swayosd/style.css",
      "reload": "pkill swayosd-server; sleep 1; hyprctl eval \"hl.exec_cmd(\\\"$(command -v swayosd-server || echo /run/current-system/sw/bin/swayosd-server)\\\")\""
    },
    {
      "_comment": "Pi coding agent TUI \u2014 matugen MD3 theme; pi hot-reloads the active theme file on edit",
      "name": "pi",
      "template": "pi-theme.json",
      "output": "~/.pi/agent/themes/matugen.json",
      "reload": ""
    },
    {
      "_comment": "wl-kbptr keyboard-pointer overlay \u2014 matugen-themed boxes/labels",
      "name": "wl-kbptr",
      "template": "wl-kbptr-config",
      "output": "~/.config/wl-kbptr/config",
      "reload": ""
    }
  ],
  "components": {
    "wallpaperSelector": {
      "enabled": true,
      "displayMode": "hex",
      "hexShape": "hexagon",
      "hexCurve": "arc",
      "hexRadius": 150,
      "hexArcIntensity": 4.5,
      "showTypeBadges": false
    }
  },
  "filterBar": {
    "visualStyle": "match",
    "show": {
      "random": false,
      "resolution": false,
      "tagcloud": false,
      "sort": {
        "color": true,
        "minimalist": false,
        "pop": false,
        "res": false,
        "richness": false
      },
      "type": {
        "all": true,
        "we": false
      }
    }
  },
  "launch": {
    "animation": "zoom"
  },
  "motion": {
    "filterSwapSpeed": "standard"
  },
  "performance": {
    "batteryFps": 30,
    "batteryWallpaperPerformance": true
  },
  "selector": {
    "livePreview": false
  },
  "transition": {
    "shader": "iris"
  }
}